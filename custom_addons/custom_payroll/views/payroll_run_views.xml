<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_payroll_run_tree" model="ir.ui.view">
        <field name="name">payroll.run.tree</field>
        <field name="model">payroll.run</field>
        <field name="arch" type="xml">
            <tree string="Payroll Runs" decoration-success="state=='posted'" decoration-warning="state=='confirmed'" decoration-muted="state=='cancelled'">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="company_id"/>
                <field name="total_gross" widget="monetary"/>
                <field name="total_net" widget="monetary"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_payroll_run_form" model="ir.ui.view">
        <field name="name">payroll.run.form</field>
        <field name="model">payroll.run</field>
        <field name="arch" type="xml">
            <form string="Payroll Run">
                <header>
                    <button name="action_generate_lines" string="Generate Lines" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_post_accounting" string="Post to Accounting" type="object" class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state not in ('draft', 'confirmed')"/>
                    <button name="action_reset_draft" string="Set to Draft" type="object" class="btn-secondary" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="journal_id"/>
                            <field name="total_gross" widget="monetary" readonly="1"/>
                            <field name="total_net" widget="monetary" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payroll Lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="employee_id" widget="many2one_avatar_employee"/>
                                    <field name="basic_salary" widget="monetary"/>
                                    <field name="gross_amount" widget="monetary"/>
                                    <field name="total_deductions" widget="monetary"/>
                                    <field name="net_amount" widget="monetary"/>
                                </tree>
                                <form>
                                    <sheet>
                                        <group>
                                            <field name="employee_id" widget="many2one_avatar_employee"/>
                                            <field name="basic_salary" widget="monetary"/>
                                            <field name="gross_amount" widget="monetary"/>
                                            <field name="total_deductions" widget="monetary"/>
                                            <field name="net_amount" widget="monetary"/>
                                        </group>
                                        <notebook>
                                            <page string="Rule Breakdown">
                                                <field name="rule_line_ids">
                                                    <tree>
                                                        <field name="sequence" widget="handle"/>
                                                        <field name="code"/>
                                                        <field name="name"/>
                                                        <field name="rule_type" widget="badge"/>
                                                        <field name="amount" widget="monetary"/>
                                                    </tree>
                                                </field>
                                            </page>
                                        </notebook>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_payroll_run" model="ir.actions.act_window">
        <field name="name">Payroll Runs</field>
        <field name="res_model">payroll.run</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
