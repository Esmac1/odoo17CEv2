<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- TREE VIEW -->
    <record id="view_salary_rule_tree" model="ir.ui.view">
        <field name="name">payroll.salary.rule.tree</field>
        <field name="model">payroll.salary.rule</field>
        <field name="arch" type="xml">
            <tree string="Salary Rules">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="rule_type" widget="badge"/>
                <field name="display_amount"/>
                <field name="account_id"/>
                <field name="active" widget="boolean_button"/>
            </tree>
        </field>
    </record>
    
    <!-- FORM VIEW - No attrs in header -->
    <record id="view_salary_rule_form" model="ir.ui.view">
        <field name="name">payroll.salary.rule.form</field>
        <field name="model">payroll.salary.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_archive" type="object" class="oe_stat_button" icon="fa-archive"/>
                        <button name="action_unarchive" type="object" class="oe_stat_button" icon="fa-undo"/>
                    </div>
                    
                    <div class="oe_title">
                        <label for="name" string="Salary Rule"/>
                        <h1>
                            <field name="name" placeholder="Salary Rule Name"/>
                        </h1>
                        <div class="o_asterisk">
                            <field name="code" placeholder="Code"/>
                        </div>
                    </div>
                    
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="rule_type"/>
                            <field name="amount_type"/>
                            <field name="amount" invisible="amount_type != 'fixed'"/>
                            <field name="percentage" invisible="amount_type != 'percentage'"/>
                        </group>
                        <group>
                            <field name="account_id"/>
                            <field name="account_type" readonly="1"/>
                            <field name="company_id" widget="res_company"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Nigerian Context">
                            <group>
                                <field name="is_taxable"/>
                                <field name="is_pensionable"/>
                            </group>
                        </page>
                        
                        <page string="Description">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- SEARCH VIEW -->
    <record id="view_salary_rule_search" model="ir.ui.view">
        <field name="name">payroll.salary.rule.search</field>
        <field name="model">payroll.salary.rule</field>
        <field name="arch" type="xml">
            <search string="Search Salary Rules">
                <field name="name"/>
                <field name="code"/>
                <field name="rule_type"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Basic Salary" name="basic" domain="[('rule_type', '=', 'basic')]"/>
                <filter string="Allowances" name="allowances" domain="[('rule_type', '=', 'allowance')]"/>
                <filter string="Deductions" name="deductions" domain="[('rule_type', '=', 'deduction')]"/>
                <group expand="0" string="Group By">
                    <filter string="Type" name="group_type" context="{'group_by': 'rule_type'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <!-- ACTION -->
    <record id="action_salary_rule" model="ir.actions.act_window">
        <field name="name">Salary Rules</field>
        <field name="res_model">payroll.salary.rule</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_salary_rule_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create salary rules to define allowances, deductions, and basic salary components.
            </p>
        </field>
    </record>
</odoo>
